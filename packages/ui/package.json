{
  "name": "@umahra/ui",
  "version": "0.2.0",
  "description": "Shared, customizable UI components for websites.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umahra/ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/umahra/ui#readme",
  "bugs": {
    "url": "https://github.com/umahra/ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; for (const path of [\"dist\", \"tsconfig.tsbuildinfo\"]) rmSync(path, { recursive: true, force: true });'"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@umahra/typescript": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0"
  }
}
